# ==============================================================================
# Yassarnalak Platform - Git Ignore Rules
# Covers: Frontend (Node / React / Vite / PNPM / TS), Backend (.NET / C# / ASP.NET Core),
#         IDEs, OS files, and sensitive environment secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (NEVER commit credentials, keys, or local secrets)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
appsettings.*.local.json
!appsettings.json
!appsettings.example.json
secrets.json

# Certificates, Keys & Private Credentials
*.pfx
*.p12
*.pem
*.key
*.cer

# ------------------------------------------------------------------------------
# 2. Frontend (Node.js, React, Vite, TypeScript, PNPM / NPM / Yarn)
# ------------------------------------------------------------------------------
# Dependencies
node_modules/
.pnpm-store/
.npm
.yarn/
jspm_packages/

# Production & Build outputs
dist/
dist-ssr/
build/
out/
.output/

# Caches
.cache/
.vite/
.parcel-cache/
.eslintcache
.stylelintcache
.tsbuildinfo
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 3. Backend (.NET / C# / ASP.NET Core / Entity Framework)
# ------------------------------------------------------------------------------
# Build outputs (Debug, Release, x86, x64, Any CPU)
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Ll]og/
[Ll]ogs/
*.log
publish/
Publish/
[Tt]emp/
[Tt]mp/

# Visual Studio & MSBuild generated files
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.dbmdl
*.jfm
*.cache

# Visual Studio temporary & cache directories
.vs/
.vsidx/
Generated\ Files/
GeneratedFiles/

# NuGet packages and restore artifacts
*.nupkg
*.snupkg
**/packages/*
!**/packages/build/
project.lock.json
project.assets.json
*.nuget.props
*.nuget.targets

# Unit test & Code Coverage results
[Tt]est[Rr]esult*/
TestResults/
*.trx
*.coverage
*.coveragexml

# Entity Framework & Local Database files
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-journal
*.mdf
*.ldf
*.bak

# .NET Core / ASP.NET tools
.dotnet/
.tools/

# ------------------------------------------------------------------------------
# 4. IDEs, Editors & Developer Tools
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (Rider, WebStorm, etc.)
.idea/
*.DotSettings.user
*.sln.iml

# Visual Studio for Mac / MonoDevelop
*.pidb
*.versioncontrol

# Subversion / Vim / Emacs swap files
.svn/
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 5. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

